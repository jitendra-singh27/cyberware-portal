# ─── Database ────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cyberaware

# ─── Session Secret ───────────────────────────────────────
# Use a long random string in production
SESSION_SECRET=change-this-to-a-random-secure-string

# ─── Server Port ──────────────────────────────────────────
PORT=5000

# ─── Frontend API URL ─────────────────────────────────────
# URL that the React frontend uses to reach the API
VITE_API_URL=http://localhost:5000
